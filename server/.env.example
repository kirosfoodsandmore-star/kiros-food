# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of this API (Paystack callback, receipt links, and the logo in emails at APP_URL/brand/)
APP_URL=http://localhost:4000
# Comma-separated allowed browser origins (the web app; add any other site that calls the API)
CORS_ORIGINS=http://localhost:5173
# The web app's address, used for links in emails. The admin portal is the same site under /admin.
STOREFRONT_URL=http://localhost:5173

# ── Database (PostgreSQL — Aiven in production) ──────────────────────────
# Either DATABASE_URL, or the individual DB_* values
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kiros
DB_SSL=false
DB_LOGGING=false
# Max DB connections per process (Aiven free plan allows ~20 in total)
DB_POOL_MAX=5

# ── Auth (own JWTs issued after Firebase verifies identity) ───────────────
# Use long random strings (>= 32 chars) in production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10
# Encrypts Paystack secret keys at rest (>= 32 chars). Required to save payment settings.
APP_ENCRYPTION_KEY=
# How long password-reset codes and staff invites stay valid
OTP_TTL_MINUTES=15
INVITE_TTL_HOURS=48

# ── Firebase (Authentication for staff + customers, Firestore for chat) ──
# Service account: either FIREBASE_SERVICE_ACCOUNT_JSON (whole JSON on one line)
# or the three values below. FIREBASE_API_KEY is the Web API key (Project settings → General).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_API_KEY=

# ── File storage (Cloudinary) — item photos, logos, transfer receipts ────
# Either CLOUDINARY_URL=cloudinary://key:secret@cloud_name, or the three values below
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────
EMAIL_ENABLED=true
# nodemailer = Gmail (default) · script = Google Apps Script relay
EMAIL_PROVIDER=nodemailer
# Gmail address + an App Password (Google Account → Security → App passwords)
EMAIL_USER=
EMAIL_PASSWORD=
# Sender address (optional, defaults to EMAIL_USER)
EMAIL_FROM=
# Only for EMAIL_PROVIDER=script
EMAIL_SCRIPT_URL=

# ── Payments (Paystack keys are set per restaurant in the admin portal) ───
# Public base URL Paystack redirects to after checkout (defaults to STOREFRONT_URL)
PAYSTACK_CALLBACK_URL=

# ── Restaurant sign-up ────────────────────────────────────────────────────
# The public "Create your restaurant" page works only until the first restaurant exists. Leave this false when
# the deployment serves a single restaurant; set true only if you host several and want open self-service sign-up.
ALLOW_SIGNUP=false

# ── Rider deliveries ──────────────────────────────────────────────────────
# Minutes a rider has to accept or decline a delivery before it is passed to the next on-duty rider (0 = never).
RIDER_ACCEPT_MINUTES=3

# ── Platform admin ────────────────────────────────────────────────────────
# Comma-separated emails that can open the platform view (every restaurant, sign-ups, who is online).
# They must also have a normal staff account with the same email.
PLATFORM_ADMIN_EMAILS=edoghotugiddy@gmail.com,caroline@gmail.com

# ── Realtime & background jobs ────────────────────────────────────────────
SOCKET_ENABLED=true
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
