{
  "name": "kiros-server",
  "version": "1.0.0",
  "private": true,
  "description": "Kiros REST API — multi-branch restaurant ordering (storefront, checkout, payments, admin portal)",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "migration:run": "tsx scripts/migrate.ts run",
    "migration:revert": "tsx scripts/migrate.ts revert",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "seed:farmshop": "tsx scripts/seed-farmshop.ts",
    "sync:farmshop": "tsx scripts/sync-farmshop.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
