# API
VITE_API_URL=http://localhost:4000

# Firebase web app (Project settings → General → Your apps). Not secret: access is gated by rules + the API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Push notifications for riders (Firebase Cloud Messaging). Leave blank to switch them off.
#  - sender id + app id: Project settings → General → Your apps (the same web app as above)
#  - VAPID key: Project settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Mapbox public token (pk.…) for the branch picker and address pin
VITE_MAPBOX_TOKEN=

# Default storefront slug when the app is opened at "/" (optional)
VITE_DEFAULT_STORE_SLUG=demo-kitchen
